{
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "printWidth": 120,
  "semi": true,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "tabWidth": 2,
  "tailwindFunctions": ["classNames"],
  "tailwindStylesheet": "./src/app/styles/style.css",
  "trailingComma": "all",
  "useTabs": false
}
